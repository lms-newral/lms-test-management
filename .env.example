# synappses-test -- copy to .env

PORT=5757
NODE_ENV=development

# This service's OWN database. Never the main backend's DATABASE_URL.
# Neon: the pooled connection string here, and the direct one in DIRECT_URL
# (migrations need it). Any other Postgres host: the same URL in both.
DATABASE_URL=
DIRECT_URL=

# Sessions are verified against the main backend.
# JWT_ACCESS_SECRET must be identical to the main backend's.
JWT_ACCESS_SECRET=
MAIN_API_URL=http://localhost:3000/graphql
SESSION_CACHE_SECONDS=60

# Production only. Comma-separated; an entry starting with ^ is a regex.
CORS_ORIGINS=

# Word import: BullMQ queue and the LibreOffice sidecar
REDIS_HOST=localhost
REDIS_PORT=6379
LIBREOFFICE_URL=

# S3 -- the same bucket as the main backend
ACE_S3_ENDPOINT=
ACE_S3_REGION=
ACE_S3_BUCKET=
ACE_S3_ACCESS_KEY_ID=
ACE_S3_SECRET_ACCESS_KEY=
ACE_CDN_DOMAIN=

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
